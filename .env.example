# ── Shared ────────────────────────────────────────────────────────────────────
# Full stack: use the Docker service name (http://nas_base)
# Frontend-only against an existing Drupal: use the external Drupal URL
DRUPAL_BASE_URL=http://nas_base

# ── NAS_frontend ──────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── NAS_base / Database ───────────────────────────────────────────────────────
DRUPAL_DB_HOST=db
DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=drupal
DRUPAL_DB_PASS=
MARIADB_ROOT_PASSWORD=
